# Copie para `.env` e preencha. O `.env` nunca é versionado.

# Ambiente: config.settings.dev (local), config.settings.test ou config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev

# Gere com: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# Banco. O compose monta `DATABASE_URL` a partir destes três (evite `@`, `:` e `/` na senha).
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=

# Somente prod
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=true
