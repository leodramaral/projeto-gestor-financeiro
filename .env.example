# Copie para `.env` e preencha. O `.env` nunca é versionado.

# Ambiente: config.settings.dev (local), config.settings.test ou config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev

# Gere com: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# Banco. O compose monta `DATABASE_URL` a partir destes três (evite `@`, `:` e `/` na senha).
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=
# Opcional: banco usado pelo `web` e pelo pytest no lugar de POSTGRES_DB. Em geral definido por
# `scripts/worktree new` (um banco `gestor_<nome>` por worktree); deixe em branco no checkout principal.
APP_DB_NAME=

# Somente prod
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=true

# Somente prod: e-mail por SMTP. Sem padrão (a aplicação não sobe sem elas), exceto porta e TLS.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Remetente padrão, ex.: Gestor Financeiro <nao-responda@seudominio.com.br>
DEFAULT_FROM_EMAIL=
# Base dos links nos e-mails, sem barra final, ex.: https://app.seudominio.com.br
SITE_URL=

# Assistente de IA: provedor compatível com a API da OpenAI. Verificados: Groq (padrão, plano gratuito;
# chave em https://console.groq.com) e Gemini (chave em https://aistudio.google.com/apikey). Para usar o
# Gemini, troque as duas linhas LLM_BASE_URL e LLM_MODEL pelas comentadas abaixo. Sem a chave, só a tela
# do assistente fica indisponível. Nunca versione a chave e não use dados financeiros reais com o plano
# gratuito. Provedores testados: README, "Provedores do assistente".
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# Gemini:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.1-flash-lite
# Tokens por usuário por dia (a cota de 200 mil por dia da Groq é da chave inteira, dividida entre todos)
LLM_DAILY_TOKEN_LIMIT=40000
LLM_TIMEOUT_SECONDS=20
